{
  // PGTT focus view: open with File > Open Workspace from File... > pgtt.code-workspace
  // Only hides files in the editor. Nothing is deleted, and git still tracks everything.
  "folders": [{ "path": "." }],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "files.exclude": {
      // build / environment junk
      "**/__pycache__": true,
      "**/*.egg-info": true,
      ".venv": true,
      "wandb": true,

      // other robots
      "mjlab/asset_zoo/robots/unitree_g1": true,
      "mjlab/asset_zoo/robots/unitree_h1_2": true,
      "mjlab/tasks/velocity/config/g1": true,
      "mjlab/tasks/velocity/config/g1_23dof": true,
      "mjlab/tasks/velocity/config/h1_2": true,
      "deploy/robots/g1": true,
      "deploy/robots/g1_23dof": true,
      "deploy/robots/h1_2": true,
      "deploy/thirdparty": true,

      // other tasks (motion imitation)
      "mjlab/tasks/tracking": true,
      "mjlab/motions": true,
      "scripts/csv_to_npz.py": true,
      "scripts/gcs.py": true,

      // docs and licence
      "doc": true,
      "README_zh.md": true,
      "LICENCE": true
    }
  }
}
